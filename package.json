{
  "name": "purchase-compass",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@purchase-compass/api",
    "dev:web": "npm run dev --workspace=@purchase-compass/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
