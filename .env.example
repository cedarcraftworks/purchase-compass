# Copy to .env (never commit .env). All values are optional.

# Rakuten Web Service application ID: enables real product recommendations.
# Without it, the bundled sample catalog is used.
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Load the demo purchase history on first start (true/false).
SEED_ON_START=true
# Read-only mode for a public demo.
DEMO_MODE=false
